# Template unit. Copy/rename per service; change Description and ExecStart.
[Unit]
Description=Camp Bus - fake beat publisher (stand-in for the analysis service)
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=pi
Environment=CAMPBUS_HOST=localhost
# CAMPBUS_USER=audio / CAMPBUS_PASSWORD=... for the production broker profile (see bus/acl.example)
EnvironmentFile=-/etc/campbus/fake-beat.env
WorkingDirectory=/opt/campbus/src
ExecStart=/opt/campbus/venv/bin/python tools/fake_beat.py --quiet --bpm 124
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
