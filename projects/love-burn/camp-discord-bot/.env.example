# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Your Discord server (guild) ID — right-click server icon > Copy Server ID
GUILD_ID=your_guild_id_here

# Channel ID where the bot posts scheduled announcements
ANNOUNCE_CHANNEL_ID=your_channel_id_here

# Channel ID where @mentions trigger the AI assistant (optional)
AI_CHANNEL_ID=your_ai_channel_id_here

# Optional: Discord role whose members can update/assign any build and manage announcements
# (people with Manage Server always can). Default: Camp Lead
LEAD_ROLE_NAME=Camp Lead

# Optional: Claude model for the assistant (default claude-sonnet-5-5) and per-user cooldown
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_COOLDOWN_SECONDS=30
