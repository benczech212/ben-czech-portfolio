{
  "uid": "exhibit-overview",
  "title": "Exhibit Overview",
  "tags": ["exhibit"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    { "id": 1, "type": "stat", "title": "👍 today", "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max(exhibit_feedback_count{vote=\"up\",period=\"today\"}) or vector(0)" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" } },
    { "id": 2, "type": "stat", "title": "👎 today", "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max(exhibit_feedback_count{vote=\"down\",period=\"today\"}) or vector(0)" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" }, "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" } },
    { "id": 3, "type": "stat", "title": "Exhibit state", "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "exhibit_paused" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "Running", "color": "green" }, "1": { "text": "Paused", "color": "orange" } } }] }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" } },
    { "id": 4, "type": "stat", "title": "Now playing", "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "exhibit_music_track_info", "legendFormat": "{{title}} — {{artist}}", "instant": true }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" }, "textMode": "name", "colorMode": "none", "graphMode": "none" } },
    { "id": 5, "type": "stat", "title": "Visual scene", "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "exhibit_synesthesia_scene_info", "legendFormat": "{{scene}}", "instant": true }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "name", "colorMode": "none", "graphMode": "none" } },

    { "id": 10, "type": "timeseries", "title": "Feedback per hour", "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "sum by (vote) (count_over_time({app=\"exhibit\", type=\"feedback\"} | json | __error__=\"\" [1h]))", "legendFormat": "{{vote}}" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 70 } }, "overrides": [
        { "matcher": { "id": "byName", "options": "up" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
        { "matcher": { "id": "byName", "options": "down" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] } ] } },
    { "id": 11, "type": "barchart", "title": "Feedback by visual scene", "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "sum by (scene, vote) (count_over_time({app=\"exhibit\", type=\"feedback\"} | json | __error__=\"\" [$__range]))", "legendFormat": "{{scene}} {{vote}}", "instant": true }],
      "options": { "orientation": "horizontal", "showValue": "auto", "stacking": "normal" } },

    { "id": 20, "type": "state-timeline", "title": "Visual scene", "gridPos": { "x": 0, "y": 12, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "exhibit_synesthesia_scene_info", "legendFormat": "{{scene}}" }],
      "options": { "mergeValues": true, "showValue": "never", "rowHeight": 0.8 } },
    { "id": 21, "type": "state-timeline", "title": "Music track", "gridPos": { "x": 12, "y": 12, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "exhibit_music_track_info", "legendFormat": "{{title}}" }],
      "options": { "mergeValues": true, "showValue": "never", "rowHeight": 0.8 } },

    { "id": 30, "type": "timeseries", "title": "Audio analysis (Synesthesia)", "gridPos": { "x": 0, "y": 19, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "exhibit_synesthesia_audio{band=\"level\"}", "legendFormat": "level" },
        { "refId": "B", "expr": "exhibit_synesthesia_audio{band=\"bass\"}", "legendFormat": "bass" },
        { "refId": "C", "expr": "exhibit_synesthesia_audio{band=\"intensity\"}", "legendFormat": "intensity" } ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "custom": { "fillOpacity": 15 } }, "overrides": [] } },
    { "id": 31, "type": "timeseries", "title": "Music: volume · playing · BPM", "gridPos": { "x": 12, "y": 19, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "exhibit_music_volume", "legendFormat": "volume" },
        { "refId": "B", "expr": "exhibit_music_playing", "legendFormat": "playing" },
        { "refId": "C", "expr": "exhibit_synesthesia_bpm / 200", "legendFormat": "bpm / 200" } ],
      "fieldConfig": { "defaults": { "min": 0, "custom": { "fillOpacity": 10 } }, "overrides": [] } },

    { "id": 40, "type": "state-timeline", "title": "App readiness", "gridPos": { "x": 0, "y": 26, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "exhibit_app_ready", "legendFormat": "{{app}}" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "down", "color": "red" }, "1": { "text": "ready", "color": "green" } } }] }, "overrides": [] },
      "options": { "mergeValues": true, "showValue": "never" } },
    { "id": 41, "type": "timeseries", "title": "Global look controls (Synesthesia meta)", "gridPos": { "x": 12, "y": 26, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "exhibit_synesthesia_control{bank=\"meta\", component=\"value\", name=~\"master|brightness|contrast|saturation|reactivity|hue\"}", "legendFormat": "{{name}}" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] } },

    { "id": 60, "type": "timeseries", "title": "Output FPS (Spout senders)", "gridPos": { "x": 0, "y": 33, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "exhibit_output_fps", "legendFormat": "{{sender}}" }],
      "fieldConfig": { "defaults": { "min": 0, "unit": "fps", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 24 }, { "color": "green", "value": 50 }] }, "custom": { "thresholdsStyle": { "mode": "dashed" } } }, "overrides": [] } },
    { "id": 61, "type": "timeseries", "title": "CPU · memory · GPU", "gridPos": { "x": 8, "y": 33, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "100 - (avg(rate(windows_cpu_time_total{mode=\"idle\"}[1m])) * 100)", "legendFormat": "CPU %" },
        { "refId": "B", "expr": "100 * (1 - windows_memory_physical_free_bytes / windows_memory_physical_total_bytes)", "legendFormat": "memory %" },
        { "refId": "C", "expr": "exhibit_gpu_utilization_percent", "legendFormat": "GPU %" },
        { "refId": "D", "expr": "100 * exhibit_gpu_memory_used_bytes / exhibit_gpu_memory_total_bytes", "legendFormat": "VRAM %" } ],
      "fieldConfig": { "defaults": { "min": 0, "max": 100, "unit": "percent" }, "overrides": [] } },
    { "id": 62, "type": "timeseries", "title": "GPU temperature · power", "gridPos": { "x": 16, "y": 33, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "exhibit_gpu_temperature_celsius", "legendFormat": "°C" },
        { "refId": "B", "expr": "exhibit_gpu_power_watts", "legendFormat": "W" } ],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] } },
    { "id": 63, "type": "timeseries", "title": "Process CPU (windows_exporter)", "gridPos": { "x": 0, "y": 40, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (process) (rate(windows_process_cpu_time_total[1m])) * 100", "legendFormat": "{{process}}" }],
      "fieldConfig": { "defaults": { "min": 0, "unit": "percent" }, "overrides": [] } },
    { "id": 64, "type": "bargauge", "title": "Disk free", "gridPos": { "x": 12, "y": 40, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "windows_logical_disk_free_bytes{volume=~\"[A-Z]:\"}", "legendFormat": "{{volume}}", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] }, "options": { "orientation": "horizontal", "displayMode": "gradient" } },
    { "id": 65, "type": "stat", "title": "Windows uptime", "gridPos": { "x": 18, "y": 40, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "exhibit_system_uptime_seconds" }],
      "fieldConfig": { "defaults": { "unit": "dtdurations" }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" } },
    { "id": 50, "type": "logs", "title": "Recent feedback", "gridPos": { "x": 0, "y": 47, "w": 12, "h": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{app=\"exhibit\", type=\"feedback\"} | json | line_format \"{{if eq .vote \\\"up\\\"}}👍{{else}}👎{{end}}  scene={{.scene}}  track={{.track}} — {{.artist}}  {{if .note}}note={{.note}}{{end}} {{if .tags}}tags={{.tags}}{{end}}\"" }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "dedupStrategy": "none", "enableLogDetails": true } },
    { "id": 51, "type": "logs", "title": "Event stream", "gridPos": { "x": 12, "y": 47, "w": 12, "h": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{app=\"exhibit\"} | json | line_format \"{{.type}} {{.name}}{{.scene}}{{.title}}{{.vote}} {{.macro}}\"" }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "dedupStrategy": "none" } }
  ]
}
